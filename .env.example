# =====================================================================
# BARD'S TAVERN — REAL-TIME MULTIPLAYER AUDIO ENVIRONMENT
# =====================================================================
# Copy this file to `.env` or `.env.local` and add your project keys.

# ---------------------------------------------------------------------
# 1. SUPABASE REALTIME, DATABASE & STORAGE
# Obtain these from your Supabase Project Settings -> API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# ---------------------------------------------------------------------
# 2. DISCORD BOT CREDENTIALS (Optional - For GM Voice Bot integration)
# Obtain these from https://discord.com/developers/applications
# ---------------------------------------------------------------------
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------
# 3. SERVICE-TO-SERVICE SECURITY SECRET (Optional)
# ---------------------------------------------------------------------
DISCORD_INTEGRATION_SECRET=change_this_to_a_secure_random_string_in_production
DISCORD_BOT_PORT=3001
DISCORD_BOT_HOST=127.0.0.1
